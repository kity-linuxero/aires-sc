          "query": "from(bucket: \"aires\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"liebert_ac\" and r._field == \"value_str\" and r.item_name == \"SinglState\")\n  |> group(columns: [\"equipo\"])\n  |> last()\n  |> map(fn: (r) => ({r with _value: if r._value == \"Alarm On\" then 2.0 else if r._value == \"Warning On\" then 1.0 else 0.0}))\n  |> keep(columns: [\"_time\", \"_value\", \"equipo\"])",
