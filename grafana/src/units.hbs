<div class="u {{st_cls}}">
  <div class="hd">
    <span class="nm">{{equipo}}</span>
    <span class="pill {{st_cls}}"><i class="ti {{st_icon}}"></i>{{st_txt}}</span>
    <div class="rd">
      <span class="{{t_cls}}"><i class="ti ti-temperature"></i> Retorno <b>{{t_txt}}</b></span>
      <span class="{{h_cls}}"><i class="ti ti-droplet-half-2"></i> Humedad <b>{{h_txt}}</b></span>
    </div>
  </div>
  <div class="g">
    <div class="t {{fan_cls}}"><i class="ti ti-propeller"></i><div class="l">Ventilador</div><div class="v">{{fan_txt}}</div></div>
    <div class="t {{cool_cls}}"><i class="ti ti-snowflake"></i><div class="l">Compresor</div><div class="v">{{cool_txt}}</div></div>
    <div class="t {{deh_cls}}"><i class="ti ti-droplet-off"></i><div class="l"><span class="full">Deshumidif.</span><span class="short">Deshum.</span></div><div class="v">{{deh_txt}}</div></div>
    <div class="t {{hum_cls}}"><i class="ti ti-droplet"></i><div class="l"><span class="full">Humidificador</span><span class="short">Humidif.</span></div><div class="v">{{hum_txt}}</div></div>
  </div>
</div>
