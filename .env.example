# Copiar este archivo como .env y reemplazar todos los valores de muestra.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-influx-password
INFLUX_ORG=iplyc
INFLUX_BUCKET=aires
INFLUX_TOKEN=change-me-long-random-influx-token

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# URL pública de Grafana. Reemplazar en producción si hay proxy reverso/dominio.
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_LIVE_ALLOWED_ORIGINS=http://localhost:3000

# simulation: relee datasets/aa*.txt; real: consulta las IP configuradas.
MONITORING_MODE=simulation
LIEBERT_AA1_IP=192.168.6.1
LIEBERT_AA2_IP=192.168.6.2
LIEBERT_AA3_IP=192.168.6.3
LIEBERT_SYS_IP=192.168.6.4

# API de lectura (puerto publicado y clave). Si API_KEY esta vacia, no se exige clave.
API_PORT=8000
API_KEY=change-me-api-key

# Notificaciones por Telegram (servicio opcional, profile "notifier").
# Token del bot (@BotFather) e id del grupo (suele ser negativo, ej. -1001234567890).
# Descubrir el id con: python notifier/telegram_test.py --updates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Limites de temperatura de retorno (°C). Ajustar a los valores de operacion reales.
TEMP_HIGH=28
TEMP_LOW=16
# Margen para dar el aviso de "normalizada" (evita avisos intermitentes).
TEMP_HYSTERESIS=1
# Opcional, por equipo (AA1, AA2, AA3, SYSTEM): pisa el limite general.
#TEMP_HIGH_AA1=30
#TEMP_LOW_AA1=14
# Segundos entre lecturas y minutos entre recordatorios mientras siga fuera de rango (0 = no repetir).
NOTIFY_INTERVAL=60
NOTIFY_REPEAT_MIN=60
